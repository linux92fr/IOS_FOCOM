# Supabase configuration
# Copy this file to `.env` and replace the placeholder values.
#
# Use only a public publishable/anon key in the Android application.
# Never put a service_role key or any private server secret in this file.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
